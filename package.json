{
  "name": "@local/dsh-startup-manager",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Startup items manager for DSH: scan and manage Windows auto-start entries (registry Run keys, Startup folders, scheduled tasks, services), highlight newly installed ones, and toggle them from a clean panel",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/*.md"
  ],
  "keywords": ["dsh", "plugin", "startup", "autoruns", "windows"],
  "license": "MIT",
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
